encode desktop app (GUI)\u001b[0m                          \r\n\u001b[38;5;238m┃\u001b[0m   \u001b[38;5;252mpi — Pi, the minimal terminal coding agent\u001b[0m                                 \r\n\u001b[38;5;238m┃\u001b[0m   \u001b[38;5;252mpowershell — Disposable PowerShell shell\u001b[0m                                   \r\n\u001b[38;5;238m┃\u001b[0m   \u001b[38;5;252mqwen — Qwen Code CLI (Alibaba)\u001b[0m                                             \r\n\u001b[38;5;238m┃\u001b[0m   \u001b[38;5;252mt3code — T3 Code desktop app — agent harness control surface\u001b[0m               \r\n\u001b[38;5;238m┃\u001b[0m   \u001b[38;5;252mtrivy — Trivy vulnerability scanner\u001b[0m                                        \r\n\u001b[K\r\n\u001b[38;2;97;97;97m↑\u001b[0m \u001b[38;2;73;73;73mup\u001b[0m\u001b[38;2;60;60;60m • \u001b[0m\u001b[38;2;97;97;97m↓\u001b[0m \u001b[38;2;73;73;73mdown\u001b[0m\u001b[38;2;60;60;60m • \u001b[0m\u001b[38;2;97;97;97m/\u001b[0m \u001b[38;2;73;73;73mfilter\u001b[0m\u001b[38;2;60;60;60m • \u001b[0m\u001b[38;2;97;97;97menter\u001b[0m \u001b[38;2;73;73;73msubmit\u001b[0m\u001b[K\u001b[79D"]
