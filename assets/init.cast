[0.019709, "o", "\u001b[?2026h\u001b[16A\r\u001b[2K\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[3m\u001b[38;5;244mConfirmed: the first \u001b[39m\u001b[23m\u001b[38;5;109m\\\u001b[39m\u001b[3m\u001b[38;5;244m\u001b[3m\u001b[38;5;244m is missing. Ruby's heredoc \u001b[39m\u001b[23m\u001b[38;5;109m<<~\u001b[39m\u001b[3m\u001b[38;5;244m\u001b[3m\u001b[38;5;244m processes the content   \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[3;38;5;244mlike a double-quoted string, and apparently \u001b[39m\u001b[23m\u001b[38;5;109m\\_\u001b[39m\u001b[3m\u001b[38;5;244m\u001b[3m\u001b[38;5;244m ... wait no, od shows the      \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[3;38;5;244mfirst line is \u001b[39m\u001b[23m\u001b[38;5;109m / _ / \\\u001b[39m\u001b[3m\u001b[38;5;244m\u001b[3m\u001b[38;5;244m — missing leading \u001b[39m\u001b[23m\u001b[38;5;109m\\\u001b[39m\u001b[3m\u001b[38;5;244m\u001b[3m\u001b[38;5;244m. So \u001b[39m\u001b[23m\u001b[38;5;109m\\_\u001b[39m\u001b[3m\u001b[38;5;244m\u001b[3m\u001b[38;5;244m became \u001b[39m\u001b[23m\u001b[38;5;109m_\u001b[39m\u001b[3m\u001b[38;5;244m\u001b[3m\u001b[38;5;244m. That means Ruby   \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[3;38;5;244mtreated \u001b[39m\u001b[23m\u001b[38;5;109m\\_\u001b[39m\u001b[3m\u001b[38;5;244m\u001b[3m\u001b[38;5;244m as... hmm, in Ruby double-quoted strings \u001b[39m\u001b[23m\u001b[38;5;109m\\_\u001b[39m\u001b[3m\u001b[38;5;244m\u001b[3m\u001b[38;5;244m should remain. But     \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[3;38;5;244mactually, I recall that in Ruby heredocs, \u001b[39m\u001b[23m\u001b[38;5;109m\\_\u001b[39m\u001b[3m\u001b[38;5;244m\u001b[3m\u001b[38;5;244m might be interpreted. Let me     \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[3;38;5;244mjust check: \u001b[39m\u001b[23m\u001b[38;5;109mputs \"\\_\"\u001b[39m\u001b[3m\u001b[38;5;244m\u001b[3m\u001b[38;5;244m in Ruby.\u001b[39m\u001b[23m                                                \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K                                                                               \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[3m\u001b[38;5;244mActually the safest fix: use a single-quoted heredoc \u001b[39m\u001b[23m\u001b[38;5;109m<<~'ASCII'\u001b[39m\u001b[3m\u001b[38;5;244m\u001b[3m\u001b[38;5;244m which does no \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[3;38;5;244minterpolation/escape processing at all.\u001b[39m\u001b[23m                                       \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K Ruby's heredoc processed the escape. Fixing with a single-quoted heredoc:     \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[48;5;17m                                                                               \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[48;5;17m \u001b[38;5;188m\u001b[1medit\u001b[22m\u001b[39m \u001b[38;5;244m...\u001b[39m                                                                      \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[48;5;17m                                                                               \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[38;5;109m⠧\u001b[39m \u001b[38;5;244mWorking...\u001b[39m                                                                  \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[38;5;139m─\u001b[39m\u001b[38;5;139m─\u001b[39m\u001b[38;5;139m─\u001b[39m\u001b[38;5;139m─\u001b[39m\u001b[38;5;139m─\u001b[39m\u001b[38;5;139m─\u001b[39m\u001b[38;5;139m─\u001b[39m\u001b[38;5;139m─\u001b[39m\u001b[38;5;139m─\u001b[39m\u001b[38;5;139m─\u001b[39m\u001b[38;5;139m─\u001b[39m\u001b[38;5;139m─\u001b[39m\u001b[38;5;139m─\u001b[39m\u001b[38;5;139m─\u001b[39m\u001b[38;5;139m─\u001b[39m\u001b[38;5;139m─\u001b[39m\u001b[38;5;139m─\u001b[39m\u001b[38;5;139m─\u001b[39m\u001b[38;5;139m─\u001b[39m\u001b[38;5